<% batches.each do |batch| %>
  <%
    # `polymorphic_path([:synchronize, batch])` / `polymorphic_path(batch)`.
    base_path = batch.is_a?(MarcBatch) ? "/marc_batches" : "/batches"
  %>
  <div class="batch">
    <h3>Batch <%= batch.id %></h3>
    <% unless batch.synchronized? %>
      <a class="btn btn-primary" rel="nofollow" data-method="post" href="<%= base_path %>/<%= batch.id %>/synchronize">Synchronize</a>
      <a class="btn btn-danger" rel="nofollow" data-method="delete" data-confirm="Are you sure?" href="<%= base_path %>/<%= batch.id %>">Delete</a>
    <% end %>
    <a class="btn btn-secondary" href="<%= base_path %>/<%= batch.id %>.csv">Export as CSV</a>
    <table class="table datatable">
      <thead>
        <tr>
          <th>Identifier</th>
          <th>Barcode</th>
          <th>Location</th>
          <th>Container Profile</th>
          <th>Container</th>
          <th>Previous Call Number</th>
          <th>Synchronization</th>
        </tr>
      </thead>
      <tbody>
        <% batch.absolute_identifiers.each do |abid| %>
          <tr>
            <td><%= abid.full_identifier %></td>
            <td><%= abid.barcode %></td>
            <%# MarcBatch has neither #location nor #container_profile; the
                Rails partial reached them through `try`. %>
            <td><%= batch.respond_to?(:location) ? batch.location&.title : nil %></td>
            <td><%= batch.respond_to?(:container_profile) ? batch.container_profile&.name : nil %></td>
            <td><%= abid.original_box_number %></td>
            <td><%= abid.previous_call_number %></td>
            <td><%= abid.sync_status %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>
