<div id="welcome" class="row m-3 p-3 align-items-center align-content-center">
  <h2>Absolute Identifier Management</h1>
  <% if current_user %>
    This system is only accessible by users of Princeton University Library's ArchivesSpace.
  <% else %>
    <div class="col-4"></div>
    <div id="welcome-login" class="col-3">
      <%= form_tag(user_openid_connect_omniauth_authorize_path) do %>
        <%= button_tag "LOGIN with NetID", type: "submit", class: "btn btn-primary" %>
      <% end %>
    </div>
    <div class="col-4"></div>
  <% end %>
</div>
